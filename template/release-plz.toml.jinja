# release-plz: the mod's version and CHANGELOG.md from conventional commits,
# tags `v<version>`. Runs only by hand through the release-plz workflow; the
# dev builds come from dev-build.yml.

[workspace]
# The mod is not published to crates.io: its versions live in git tags.
git_only = true
publish = false
# `release` acts only when the newest commit on main is a merged release pull
# request, so a stray run releases nothing.
release_always = false
# A version with a prerelease part (`0.2.0-alpha.1`) makes a GitHub prerelease.
git_release_type = "auto"
{% raw %}git_tag_name = "v{{ version }}"
git_release_name = "{% endraw %}{{ mod_name }}{% raw %} {{ version }}"{% endraw %}
# Renovate moves the dependencies.
dependencies_update = false
pr_labels = ["release"]
# The pull request body follows the repository's form: outcome bullets;
# CHANGELOG.md in the pull request holds the details.
pr_body = """{% raw %}
## Chores

{% for release in releases -%}
- Released `{{ release.package }}` {{ release.next_version }}{% if release.previous_version and release.previous_version != release.next_version %} (was {{ release.previous_version }}){% endif %}.
{% endfor %}
`CHANGELOG.md` in this pull request lists what changed.
{% endraw %}"""

[[package]]
name = "xtask"
release = false
